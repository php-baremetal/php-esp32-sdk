# ext/uri, which the core requires since PHP 8.5: the RFC 3986 (uriparser) and parse_url() parsers. lexbor is not
# built (its static tables do not fit in internal RAM): compat/uri_whatwg_stub.c stands in for the WHATWG parser, so
# Uri\WhatWg\Url registers but throws when constructed, and patch 0014 drops ext/uri's dependency on the lexbor module.
set(PHP_URI_SRCS
    ${PHP_SRC}/ext/uri/php_uri.c
    ${PHP_SRC}/ext/uri/php_uri_common.c
    ${PHP_SRC}/ext/uri/uri_parser_php_parse_url.c
    ${PHP_SRC}/ext/uri/uri_parser_rfc3986.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriCommon.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriCompare.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriCopy.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriEscape.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriFile.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriIp4.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriIp4Base.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriMemory.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriNormalize.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriNormalizeBase.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriParse.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriParseBase.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriQuery.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriRecompose.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriResolve.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetFragment.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetHostAuto.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetHostCommon.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetHostIp4.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetHostIp6.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetHostIpFuture.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetHostRegName.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetPath.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetPort.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetQuery.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetScheme.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriSetUserInfo.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriShorten.c
    ${PHP_SRC}/ext/uri/uriparser/src/UriVersion.c
    ${PHP_VER_DIR}/compat/uri_whatwg_stub.c
)
list(APPEND PHP_SRCS ${PHP_URI_SRCS})
if(NOT CMAKE_BUILD_EARLY_EXPANSION)
    # ext/lexbor only for the lexbor/url/url.h that php_uri.c includes through uri_parser_whatwg.h; nothing of it is compiled.
    set_source_files_properties(${PHP_URI_SRCS} PROPERTIES
        INCLUDE_DIRECTORIES "${PHP_SRC}/ext/uri;${PHP_SRC}/ext/uri/uriparser/include;${PHP_SRC}/ext/lexbor"
        COMPILE_DEFINITIONS "URI_STATIC_BUILD;URI_ENABLE_ANSI;URI_NO_UNICODE")
endif()

