{
    "name": "Waveshare ESP32-S3-Touch-LCD-1.85B",
    "chip": "esp32s3",
    "psram": "octal",
    "flash": "16MB",
    "console": "usb-jtag",
    "microsd": {
        "type": "spi",
        "cs": 13,
        "sclk": 15,
        "mosi": 14,
        "miso": 16
    },
    "network": {
        "type": "wifi"
    },
    "display": { "type": "st77916", "sclk": 40, "d0": 46, "d1": 45, "d2": 42, "d3": 41, "cs": 21, "rst": 3, "bl": 5, "width": 360, "height": 360, "te": 18 },
    "i2c": { "type": "i2c", "sda": 11, "scl": 10 },
    "touch": { "type": "cst816s", "int": 4, "rst": 1, "width": 360, "height": 360 }
}
