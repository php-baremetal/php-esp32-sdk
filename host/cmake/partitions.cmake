set(_storage_kb 0)
if(PHPBM_STORAGE STREQUAL "embedded")
    if(NOT IS_DIRECTORY "${PHPBM_APP_SRC}")
        message(FATAL_ERROR "project sources not found in ${PHPBM_APP_SRC}")
    endif()
    file(GLOB_RECURSE _entries LIST_DIRECTORIES true "${PHPBM_APP_SRC}/*")
    set(_used 4096)
    foreach(_entry IN LISTS _entries)
        if(IS_DIRECTORY "${_entry}")
            math(EXPR _used "${_used} + 4096")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_entry}")
        else()
            file(SIZE "${_entry}" _size)
            math(EXPR _used "${_used} + ((${_size} + 4095) / 4096) * 4096")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_entry}")
        endif()
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PHPBM_APP_SRC}")
    math(EXPR _bytes "${_used} + 65536 + ${_used} / 8")
    math(EXPR _bytes "((${_bytes} + 65535) / 65536) * 65536")
    if(_bytes LESS 131072)
        set(_bytes 131072)
    endif()
    math(EXPR _storage_kb "${_bytes} / 1024")
endif()

set(_packages_kb 0)
set(_packages_csv "")
foreach(_partition IN LISTS PHPBM_PARTITIONS)
    string(REPLACE "," ";" _partition "${_partition}")
    list(GET _partition 0 _name)
    list(GET _partition 1 _subtype)
    list(GET _partition 2 _kb)
    math(EXPR _packages_kb "${_packages_kb} + ${_kb}")
    string(APPEND _packages_csv "${_name}, data, ${_subtype}, , ${_kb}K\n")
endforeach()

# On quad flash the cache maps only the first 16 MB (32-bit addressing is experimental in IDF): the partitions must sit below it.
set(_layout_kb ${PHPBM_FLASH_KB})
if(PHPBM_FLASH_MODE STREQUAL "quad" AND _layout_kb GREATER 16384)
    set(_layout_kb 16384)
endif()
math(EXPR _factory_kb "((${_layout_kb} - 128 - ${_storage_kb} - ${_packages_kb}) / 64) * 64")
if(_factory_kb LESS 1024)
    message(FATAL_ERROR "the project sources (${_storage_kb}K) and the package partitions (${_packages_kb}K) leave ${_factory_kb}K for the firmware (at least 1024K): use a board with more flash or the microsd storage")
endif()

set(_csv "nvs,      data, nvs,     , 24K\nphy_init, data, phy,     , 4K\nfactory,  app,  factory, , ${_factory_kb}K\n${_packages_csv}")
if(_storage_kb GREATER 0)
    string(APPEND _csv "storage,  data, fat,     , ${_storage_kb}K\n")
endif()
set(_cfg "CONFIG_PARTITION_TABLE_CUSTOM=y\nCONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"${CMAKE_BINARY_DIR}/partitions.csv\"\n")
foreach(_pair "partitions.csv|_csv" "partitions.sdkconfig|_cfg")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _name)
    list(GET _pair 1 _var)
    set(_old "")
    if(EXISTS "${CMAKE_BINARY_DIR}/${_name}")
        file(READ "${CMAKE_BINARY_DIR}/${_name}" _old)
    endif()
    if(NOT _old STREQUAL "${${_var}}")
        file(WRITE "${CMAKE_BINARY_DIR}/${_name}" "${${_var}}")
    endif()
endforeach()
list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_BINARY_DIR}/partitions.sdkconfig")
